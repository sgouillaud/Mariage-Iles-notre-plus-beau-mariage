# Copiez ce fichier en .env pour un essai en local. NE JAMAIS le publier sur GitHub.
# En production (Railway), ces valeurs se saisissent dans l'onglet « Variables ».

# Mot de passe de l'espace /admin (10 caractères minimum, idéalement 16+)
ADMIN_PASSWORD=changez-moi-mot-de-passe-long

# Secret de signature des sessions (32 caractères minimum, aléatoire)
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez-par-une-chaine-aleatoire-de-64-caracteres

# Emplacement de la base SQLite (en production : /data/mariage.db sur le volume)
DB_PATH=./data/mariage.db

PORT=3000
NODE_ENV=development
